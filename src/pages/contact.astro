---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import QuoteSection from '../components/QuoteSection.astro';
import Icon from '../components/Icon.astro';
import { site, fullAddress, mapsEmbedUrl, mapsDirectionsUrl } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const base = Astro.site!;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
];
---

<BaseLayout
  title="Contact Us & Free Quote | Supreme Electrical Contractors"
  description="Contact Supreme Electrical Contractors at 25 Jutland Way, Epping VIC 3076. Call Alex on 0437 898 022, email, or request a free quote online."
  quoteHref="#quote"
  schema={[breadcrumbSchema(breadcrumbs, base)]}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    eyebrow="Contact"
    title="Contact Us"
    lead={`Call ${site.contactName} on ${site.phone.display}, send an email, or request a free quote below.`}
    quoteHref="#quote"
    showCtas={false}
    wide
  >
    <ul class="quick-contact" role="list">
      <li>
        <a class="quick-card quick-card--primary" href={site.phone.href}>
          <Icon name="phone" />
          <span>
            <span class="quick-label">Call {site.contactName}</span>
            <span class="quick-value">{site.phone.display}</span>
          </span>
        </a>
      </li>
      <li>
        <a class="quick-card" href={`mailto:${site.email}`}>
          <Icon name="mail" />
          <span>
            <span class="quick-label">Email</span>
            <span class="quick-value quick-value--email">{site.email}</span>
          </span>
        </a>
      </li>
      <li>
        <a class="quick-card" href="#quote">
          <Icon name="fileText" />
          <span>
            <span class="quick-label">Online</span>
            <span class="quick-value">Request a free quote</span>
          </span>
        </a>
      </li>
    </ul>
  </PageHero>

  <QuoteSection
    title="Request a free quote"
    lead={`Fill in the form and ${site.contactName} will get back to you. For anything urgent, call ${site.phone.display}.`}
    eyebrow="Quote request"
    showHours
  />

  <section class="section theme-light" aria-labelledby="map-title">
    <div class="container">
      <div class="map-head" data-reveal>
        <div>
          <p class="eyebrow">Find us</p>
          <h2 id="map-title">{fullAddress}</h2>
        </div>
        <a class="btn btn-dark" href={mapsDirectionsUrl} target="_blank" rel="noopener">
          <Icon name="navigation" />
          Get directions<span class="visually-hidden"> (opens Google Maps in a new tab)</span>
        </a>
      </div>
      <div class="map-frame">
        <iframe
          src={mapsEmbedUrl}
          title={`Google Map showing ${site.name} at ${fullAddress}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .quick-contact {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  @media (min-width: 48em) {
    .quick-contact {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .quick-card {
    --icon-size: 1.4rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: 100%;
    padding: 1rem 1.15rem;
    border: 1px solid var(--line-on-dark);
    border-radius: var(--radius);
    background: var(--charcoal-2);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.2s var(--ease-out);
  }

  .quick-card:hover {
    border-color: var(--yellow);
    transform: translateY(-2px);
  }

  .quick-card :global(.icon) {
    color: var(--yellow);
  }

  .quick-card--primary {
    border-color: var(--yellow);
    background: var(--yellow);
    color: var(--ink);
  }

  .quick-card--primary :global(.icon) {
    color: var(--ink);
  }

  .quick-card--primary:focus-visible {
    outline-color: var(--yellow);
  }

  .quick-label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .quick-value {
    display: block;
    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .quick-value--email {
    font-size: 1rem;
    overflow-wrap: anywhere;
  }

  .map-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-bottom: 2rem;
  }

  .map-head h2 {
    font-size: var(--step-2);
  }

  .map-frame {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--paper);
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 48em) {
    .map-frame {
      aspect-ratio: 21 / 9;
    }
  }

  .map-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
