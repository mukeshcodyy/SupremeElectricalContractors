---
/** Fixed call / quote bar on phones. Hidden from 768px up, where the header shows the call button. */
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  quoteHref: string;
}

const { quoteHref } = Astro.props;
---

<div class="mobile-bar">
  <a class="mobile-bar-btn mobile-bar-call" href={site.phone.href}>
    <Icon name="phone" />
    Call Now<span class="visually-hidden"> on {site.phone.display}</span>
  </a>
  <a class="mobile-bar-btn mobile-bar-quote" href={quoteHref}>
    <Icon name="fileText" />
    Get a Quote
  </a>
</div>

<style>
  .mobile-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    padding: 0.55rem 0.6rem calc(0.55rem + env(safe-area-inset-bottom));
    background: rgb(17 18 20 / 0.97);
    border-top: 1px solid var(--line-on-dark);
    box-shadow: 0 -10px 30px -12px rgb(0 0 0 / 0.45);
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-bar {
      transition: transform 0.25s var(--ease-out);
    }
  }

  @media (min-width: 48em) {
    .mobile-bar {
      display: none;
    }
  }

  /* Slide away while someone is typing in the quote form */
  :global(html:has(.quote-form :is(input, textarea):focus)) .mobile-bar {
    transform: translateY(110%);
  }

  .mobile-bar-btn {
    --icon-size: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.25rem;
    border-radius: 10px;
    font-size: 1.0625rem;
    font-weight: 800;
    text-decoration: none;
  }

  .mobile-bar-call {
    background: var(--yellow);
    color: var(--ink);
  }

  .mobile-bar-quote {
    border: 2px solid rgb(255 255 255 / 0.85);
    color: var(--white);
  }

  .mobile-bar-btn:focus-visible {
    outline-color: var(--yellow);
  }
</style>
