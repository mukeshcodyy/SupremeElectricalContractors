---
/**
 * Instagram call-out with six photo tiles linking to the account. The first two are
 * from the Instagram account; the rest are job photos from the business's website.
 */
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import { site } from '../../data/site';
import townhouses from '../../assets/photos/townhouse-build-vans.jpg';
import kitchen from '../../assets/photos/white-kitchen.jpg';
import lift from '../../assets/photos/warehouse-scissor-lift.jpg';
import switchboard from '../../assets/photos/switchboard-work.jpg';
import team from '../../assets/photos/team-on-site.jpg';
import officeWarehouse from '../../assets/photos/office-warehouse-aerial.jpg';

const { url, handle } = site.social.instagram;
const tiles = [townhouses, switchboard, kitchen, lift, officeWarehouse, team];
---

<section class="section theme-light insta" aria-labelledby="insta-title">
  <div class="container">
    <div class="insta-head" data-reveal>
      <div>
        <p class="eyebrow">Instagram</p>
        <h2 id="insta-title">Follow our work <span class="insta-handle">{handle}</span></h2>
        <p class="lead">Recent jobs and finished work, straight from the tools.</p>
      </div>
      <a class="btn btn-dark btn-lg" href={url} target="_blank" rel="noopener">
        <Icon name="instagram" />
        Follow on Instagram<span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    </div>

    <ul class="insta-grid" role="list" data-reveal>
      {
        tiles.map((tile) => (
          <li>
            <a class="insta-tile" href={url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
              <Image src={tile} alt="" width={400} height={400} fit="cover" />
              <span class="insta-tile-icon">
                <Icon name="instagram" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .insta-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .insta-head h2 {
    max-width: 40rem;
  }

  /* The handle is one long word, so it gets its own line and scales with the viewport */
  .insta-handle {
    display: block;
    margin-top: 0.3rem;
    font-size: clamp(1.05rem, 0.6rem + 2.6vw, 2rem);
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .insta-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }

  @media (min-width: 48em) {
    .insta-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 0.75rem;
    }
  }

  .insta-tile {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--charcoal-2);
  }

  .insta-tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-out);
  }

  .insta-tile:hover :global(img) {
    transform: scale(1.06);
  }

  .insta-tile-icon {
    --icon-size: 1.1rem;
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgb(17 18 20 / 0.7);
    color: var(--yellow);
  }
</style>
