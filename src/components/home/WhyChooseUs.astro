---
import Icon from '../Icon.astro';
import type { IconName } from '../../data/icons';
import { site } from '../../data/site';

const points: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'shieldCheck',
    title: 'Licensed & insured',
    text: 'All work is carried out by licensed electricians and completed to Australian Standards.',
  },
  {
    icon: 'zap',
    title: 'One contractor for every job',
    text: 'From a new power point at home to three-phase power in a factory, one team handles it all.',
  },
  {
    icon: 'messageSquare',
    title: 'Straight talk, free quotes',
    text: `Speak directly with ${site.contactName} and get a clear, free quote before any work starts.`,
  },
  {
    icon: 'mapPin',
    title: 'Based in Epping',
    text: `Local electricians working out of ${site.address.street}, ${site.address.suburb}, in ${site.address.region}.`,
  },
];
---

<section class="section theme-ink why" aria-labelledby="why-title">
  <div class="container why-grid">
    <div class="why-intro" data-reveal>
      <p class="eyebrow">Why choose us</p>
      <h2 id="why-title">Experienced, licensed and easy to deal with</h2>
      <p class="lead">Good electrical work should be safe, neat and explained clearly. That’s how we do every job.</p>
      <div class="why-stat">
        <span class="why-stat-num">20+</span>
        <span class="why-stat-label">years in the<br />electrical trade</span>
      </div>
    </div>

    <ul class="why-list" role="list">
      {
        points.map((point, index) => (
          <li class="why-item" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
            <span class="why-icon">
              <Icon name={point.icon} />
            </span>
            <h3>{point.title}</h3>
            <p>{point.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .why-grid {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 64em) {
    .why-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
      gap: clamp(3rem, 6vw, 6rem);
      align-items: center;
    }
  }

  .why-stat {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line-on-dark);
  }

  .why-stat-num {
    font-size: clamp(3.5rem, 2.5rem + 4vw, 5.5rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--yellow);
  }

  .why-stat-label {
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .why-list {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 40em) {
    .why-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .why-item {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.75rem;
    border: 1px solid var(--line-on-dark);
    border-radius: var(--radius-lg);
    background: var(--charcoal);
    transition:
      border-color 0.25s ease,
      transform 0.25s var(--ease-out);
  }

  .why-item:hover {
    border-color: rgb(255 211 45 / 0.5);
  }

  .why-icon {
    --icon-size: 1.5rem;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid rgb(255 211 45 / 0.4);
    border-radius: var(--radius);
    background: rgb(255 211 45 / 0.1);
    color: var(--yellow);
  }

  .why-item h3 {
    font-size: var(--step-1);
  }

  .why-item p {
    color: var(--muted-on-dark);
  }
</style>
