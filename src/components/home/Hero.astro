---
import Icon from '../Icon.astro';
import Photo from '../Photo.astro';
import { site } from '../../data/site';
---

<section class="hero theme-dark">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Epping · {site.address.region}</p>
      <h1>Melbourne Electricians With <span class="hero-accent">20+ Years</span> of Experience</h1>
      <p class="hero-lead">
        Residential, commercial and industrial electrical work – from switchboard upgrades and lighting at home to
        fit-outs, three-phase power and factory installations.
      </p>
      <div class="btn-row hero-ctas">
        <a class="btn btn-primary btn-lg" href={site.phone.href}>
          <Icon name="phone" />
          Call Now
        </a>
        <a class="btn btn-outline btn-lg" href="#quote">
          Get a Free Quote
          <Icon name="arrowRight" class="icon-arrow" />
        </a>
      </div>
      <p class="hero-phone">
        Talk to {site.contactName} directly: <a href={site.phone.href}>{site.phone.display}</a>
      </p>
    </div>

    <div class="hero-media">
      <Photo
        file="warehouse-scissor-lift.jpg"
        alt="Supreme Electrical Contractors electrician working from a branded scissor lift inside a warehouse"
        position="50% 18%"
        sizes="(min-width: 64em) 42vw, 100vw"
        priority
      />
      <div class="hero-badge" aria-hidden="true">
        <span class="hero-badge-num">20+</span>
        <span class="hero-badge-text">years in<br />the trade</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5.5rem) clamp(3rem, 2rem + 4vw, 6rem);
  }

  /* Blueprint grid fading out from the top right, plus a warm glow */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse 75% 85% at 85% 15%, #000 15%, transparent 72%);
    mask-image: radial-gradient(ellipse 75% 85% at 85% 15%, #000 15%, transparent 72%);
  }

  .hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: -25%;
    right: -15%;
    width: min(70rem, 90vw);
    aspect-ratio: 1;
    background: radial-gradient(circle, rgb(255 211 45 / 0.13), transparent 62%);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    gap: 2.75rem;
    align-items: center;
  }

  @media (min-width: 64em) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: clamp(3rem, 5vw, 5rem);
    }
  }

  .hero-copy {
    max-width: 42rem;
  }

  .hero h1 {
    font-size: var(--step-5);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .hero-accent {
    color: var(--yellow);
  }

  .hero-lead {
    max-width: 38rem;
    margin-top: 1.4rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--muted-on-dark);
  }

  .hero-ctas {
    margin-top: 2rem;
  }

  @media (max-width: 29.99em) {
    .hero-ctas .btn {
      flex: 1 1 100%;
    }
  }

  .hero-phone {
    margin-top: 1.1rem;
    font-size: 1rem;
    color: var(--muted-on-dark);
  }

  .hero-phone a {
    font-weight: 700;
    color: var(--text-on-dark);
    text-decoration-color: var(--yellow);
  }

  .hero-media {
    --ratio: 16 / 11;
    position: relative;
  }

  @media (min-width: 64em) {
    .hero-media {
      --ratio: 4 / 5;
    }
  }

  .hero-badge {
    position: absolute;
    left: clamp(-1.25rem, -2vw, -0.5rem);
    bottom: clamp(1rem, 4vw, 2rem);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.15rem 0.85rem 1rem;
    border-radius: var(--radius);
    background: var(--yellow);
    color: var(--ink);
    box-shadow: 0 18px 40px -16px rgb(0 0 0 / 0.7);
  }

  @media (max-width: 63.99em) {
    .hero-badge {
      left: 0.75rem;
    }
  }

  .hero-badge-num {
    font-size: 2.25rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hero-badge-text {
    font-size: 0.8125rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Gentle entrance for the photo; the headline is never hidden so it paints immediately */
  @media (prefers-reduced-motion: no-preference) {
    .hero-media {
      animation: hero-in 0.8s var(--ease-out) both 0.1s;
    }

    .hero-badge {
      animation: badge-in 0.6s var(--ease-out) both 0.45s;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }

  @keyframes badge-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.96);
    }
  }
</style>
