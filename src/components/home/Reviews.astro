---
/** Three review slots. Replace each placeholder with a real Google review (text, first name, date). */
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';

const reviews = Array.from({ length: 3 }, () => ({
  text: '[PLACEHOLDER - add real Google review]',
  name: '[PLACEHOLDER - reviewer name]',
}));
---

<section class="section theme-paper reviews" aria-labelledby="reviews-title">
  <div class="container">
    <SectionHeading id="reviews-title" eyebrow="Reviews" title="What our customers say" center />

    <ul class="reviews-grid" role="list">
      {
        reviews.map((review, index) => (
          <li class="review-card" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
            <Icon name="quote" class="review-quote" />
            <p class="review-text">
              <span class="ph-text" data-placeholder>
                {review.text}
              </span>
            </p>
            <p class="review-meta">
              <span class="review-name">
                <span class="ph-text" data-placeholder>
                  {review.name}
                </span>
              </span>
              <span class="review-source">Google review</span>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .reviews-grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 56em) {
    .reviews-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .review-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .review-card :global(.review-quote) {
    --icon-size: 2.25rem;
    padding: 0.45rem;
    border-radius: var(--radius-sm);
    background: var(--yellow);
    color: var(--ink);
    fill: var(--ink);
    stroke-width: 0;
  }

  .review-text {
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .review-meta {
    display: grid;
    gap: 0.2rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.9375rem;
  }

  .review-name {
    font-weight: 700;
  }

  .review-source {
    color: var(--muted);
  }
</style>
