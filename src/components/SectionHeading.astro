---
/** Eyebrow + H2 + optional lead paragraph. `title` may contain a <span class="mark"> highlight. */
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  id?: string;
  center?: boolean;
  class?: string;
}

const { title, eyebrow, lead, id, center = false, class: className } = Astro.props;
---

<div class:list={['section-head', { 'section-head--center': center }, className]} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} set:html={title} />
  {lead && <p class="lead">{lead}</p>}
  <slot />
</div>
