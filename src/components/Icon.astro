---
import { icons, type IconName } from '../data/icons';

interface Props {
  name: IconName;
  class?: string;
  /** Give the icon an accessible name. Without it the icon is decorative. */
  label?: string;
}

const { name, class: className, label } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={icons[name]}
/>
