---
import Icon from './Icon.astro';
import PlaceholderText from './PlaceholderText.astro';
import { site } from '../data/site';
---

<section class="trust theme-yellow" aria-label="Experience and licensing">
  <div class="container">
    <ul class="trust-list" role="list">
      <li>
        <Icon name="hardHat" />
        <span>20+ Years Experience</span>
      </li>
      <li>
        <Icon name="shieldCheck" />
        <span>Licensed &amp; Insured</span>
      </li>
      <li>
        <Icon name="idCard" />
        <span>REC No. <PlaceholderText value={site.licence.rec} /></span>
      </li>
      <li>
        <Icon name="building" />
        <span>Residential, Commercial &amp; Industrial</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .trust {
    padding-block: 1.25rem;
  }

  .trust-list {
    --icon-size: 1.6rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .trust-list li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  @media (min-width: 64em) {
    .trust {
      padding-block: 1.5rem;
    }

    .trust-list {
      grid-template-columns: repeat(4, auto);
      justify-content: space-between;
      font-size: 1.0625rem;
    }

    .trust-list li + li {
      padding-left: 1.25rem;
      border-left: 2px solid rgb(17 18 20 / 0.18);
    }
  }
</style>
