---
/** Accordion built on <details>, so it works without JavaScript. */
import { linkPhones } from '../lib/text';

interface Props {
  faqs: { question: string; answer: string }[];
}

const { faqs } = Astro.props;
---

<div class="faq">
  {
    faqs.map((faq, index) => (
      <details class="faq-item" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
        <summary class="faq-question">
          <span>{faq.question}</span>
          <span class="faq-toggle" aria-hidden="true" />
        </summary>
        <div class="faq-answer">
          <p set:html={linkPhones(faq.answer)} />
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 0.75rem;
  }

  .faq-item {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.2s ease;
  }

  .faq-item[open] {
    border-color: var(--fg);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.25rem;
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.35;
    list-style: none;
    cursor: pointer;
    border-radius: inherit;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-toggle {
    position: relative;
    width: 2rem;
    height: 2rem;
    flex: none;
    border-radius: 50%;
    background: var(--yellow);
  }

  .faq-toggle::before,
  .faq-toggle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.8rem;
    height: 2.5px;
    border-radius: 2px;
    background: var(--ink);
    transform: translate(-50%, -50%);
    transition: transform 0.25s var(--ease-out);
  }

  .faq-toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq-item[open] .faq-toggle::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq-answer {
    padding: 0 1.25rem 1.25rem;
    color: var(--muted);
  }

  .faq-answer :global(a) {
    font-weight: 700;
    color: var(--fg);
    text-decoration-color: var(--accent-text);
  }

  /* Smooth open/close where the browser supports animating to auto height */
  @media (prefers-reduced-motion: no-preference) {
    @supports (interpolate-size: allow-keywords) {
      .faq-item {
        interpolate-size: allow-keywords;
      }

      .faq-item::details-content {
        block-size: 0;
        overflow-y: clip;
        transition:
          block-size 0.3s var(--ease-out),
          content-visibility 0.3s allow-discrete;
      }

      .faq-item[open]::details-content {
        block-size: auto;
      }
    }
  }
</style>
