---
/**
 * A photo area that shows a labelled placeholder until a real photo is added.
 *
 * To swap in a photo: drop the image into src/assets/photos/ and pass its filename
 * as `file` (most photos are set in src/data/). Astro then resizes it, serves
 * AVIF/WebP and lazy-loads it. Use `priority` only for the main photo at the top of a page.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import type { IconName } from '../data/icons';

interface Props {
  /** Filename in src/assets/photos/, e.g. "switchboard-upgrade.jpg" */
  file?: string;
  /** Describes the photo. Used as alt text once a real photo is added. */
  alt: string;
  /** Placeholder heading */
  label?: string;
  /** Placeholder note describing the photo that belongs here */
  caption?: string;
  icon?: IconName;
  /** CSS aspect-ratio, e.g. "4 / 3". Defaults to 4 / 3, or a --ratio set by a parent. */
  ratio?: string;
  /** CSS object-position for cropping, e.g. "50% 20%" */
  position?: string;
  /** Responsive sizes hint for the browser */
  sizes?: string;
  priority?: boolean;
  class?: string;
}

const {
  file,
  alt,
  label = 'Project photo',
  caption,
  icon = 'camera',
  ratio,
  position = '50% 50%',
  sizes = '(min-width: 64em) 33vw, 100vw',
  priority = false,
  class: className,
} = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
const image = file ? photos[`/src/assets/photos/${file}`]?.default : undefined;

if (file && !image) {
  throw new Error(`Photo "${file}" was not found in src/assets/photos/`);
}
---

<div class:list={['photo', className]} style={`${ratio ? `--ratio: ${ratio}; ` : ''}--position: ${position}`}>
  {
    image ? (
      <Picture
        src={image}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[480, 768, 1080, 1440, 1920].filter((width) => width <= image.width)}
        sizes={sizes}
        priority={priority}
      />
    ) : (
      <div class="photo-placeholder" role="img" aria-label={`${label} placeholder: ${alt}`}>
        <Icon name={icon} class="photo-icon" />
        <span class="photo-label">{label}</span>
        {caption && <span class="photo-caption">{caption}</span>}
      </div>
    )
  }
</div>

<style>
  .photo {
    position: relative;
    aspect-ratio: var(--ratio, 4 / 3);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--charcoal-2);
  }

  .photo :global(picture),
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--position, 50% 50%);
  }

  .photo-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.45rem;
    padding: 1.5rem;
    text-align: center;
    color: var(--muted-on-dark);
    background:
      radial-gradient(120% 90% at 85% 0%, rgb(255 211 45 / 0.1), transparent 55%),
      repeating-linear-gradient(-45deg, rgb(255 255 255 / 0.035) 0 2px, transparent 2px 14px),
      linear-gradient(160deg, #2c2f34, #1b1c20);
  }

  /* Viewfinder corners */
  .photo-placeholder::before {
    content: '';
    position: absolute;
    inset: clamp(0.75rem, 3%, 1.25rem);
    pointer-events: none;
    --c: var(--yellow);
    --l: clamp(1rem, 7%, 1.75rem);
    background:
      linear-gradient(var(--c), var(--c)) top left / var(--l) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) top left / 2px var(--l) no-repeat,
      linear-gradient(var(--c), var(--c)) top right / var(--l) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) top right / 2px var(--l) no-repeat,
      linear-gradient(var(--c), var(--c)) bottom left / var(--l) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) bottom left / 2px var(--l) no-repeat,
      linear-gradient(var(--c), var(--c)) bottom right / var(--l) 2px no-repeat,
      linear-gradient(var(--c), var(--c)) bottom right / 2px var(--l) no-repeat;
    opacity: 0.85;
  }

  .photo-placeholder :global(.photo-icon) {
    --icon-size: 2rem;
    color: var(--yellow);
    margin-bottom: 0.15rem;
  }

  .photo-label {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-on-dark);
  }

  .photo-caption {
    max-width: 26ch;
    font-size: 0.875rem;
    line-height: 1.4;
  }
</style>
